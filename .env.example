# Variáveis do petro-vault (DV-289).
# Copie para .env e preencha. O .env nunca vai para o git.
#
# Cada bloco diz para que serve e quem fornece. Um .env por ambiente
# (homologação: um por dev, no clone de cada um; produção: um no servidor).

# --- Compose --------------------------------------------------------------
# Nome do conjunto de containers. Precisa ser diferente de qualquer outro
# compose da máquina (ex.: o do Petro Observer é petro-observer-<usuario>).
# Homologação: petro-vault-<seu-usuario>. Produção: petro-vault.
COMPOSE_PROJECT_NAME=petro-vault-seu-usuario

# --- API ------------------------------------------------------------------
# Porta da API no host. Uma por dev na mesma máquina (Tiago: 8670).
# Não use 8650-8652 (Hermes do observer) nem 8660 (painel do observer).
API_PORTA=8670
# Interface: 127.0.0.1 só aceita conexões do próprio servidor; 0.0.0.0 abre
# na rede interna (a tela, DV-547, precisa disso para abrir do computador de
# quem usa). A tela é protegida pelo login do AD; a API dos agentes, pela
# credencial pv_.
API_BIND=0.0.0.0
# Endereço que os consumidores usam para a API e o MCP; aparece nos comandos
# do token criado na tela (DV-599). Padrão: o IP do servidor.
# VAULT_URL_PUBLICA=http://10.2.2.31:8670

# Chave dos links de download de 15 minutos do MCP (get_file, DV-601). Sem ela,
# o serviço cria uma em estado/links.chave na primeira vez e usa sempre a mesma.
# VAULT_CHAVE_LINKS=

# --- Tela (DV-547) ----------------------------------------------------------
# Login das pessoas pelo AD: os mesmos servidores e domínio do painel do Petro
# Observer (não são segredo; o login usa a senha da própria pessoa).
LDAP_SERVERS=srv-ad01.petrovina.local,srv-ad02.petrovina.local,srv-ad03.petrovina.local
LDAP_DOMAIN=petrovina.local
# Logins do AD (sAMAccountName) que entram na tela, separados por vírgula.
# Fase 1: só administradores; a fase 2 traz dono, editor e leitor.
VAULT_ADMINS=
# Segredo do cookie da sessão (32+ caracteres; gerado no servidor, nunca
# copiado de outro ambiente): python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Vazio: a tela fica desligada.
VAULT_SESSAO_SEGREDO=
# Nome do ambiente mostrado na barra da tela.
VAULT_AMBIENTE=homologação
# 1 quando a tela estiver atrás de HTTPS (cookie só por HTTPS).
VAULT_COOKIE_SEGURO=0

# --- Vault de conteúdo ----------------------------------------------------
# Repositório onde o curador publica. Quem fornece: o dev, ao criar o repositório.
# Homologação: git@github.com:PetrovinaS/petro-vault-conteudo-teste.git
# Nunca o petro-observer-vault-teste: o curador do observer escreve nele.
VAULT_REPO=git@github.com:PetrovinaS/petro-vault-conteudo-teste.git
# Chave de deploy com escrita só nesse repositório (gerada em cada servidor,
# nunca copiada de outro; permissão 600). Montada só no vault-init.
# Homologação (10.2.2.31): /home/tiago.santo/.config/petro-vault/conteudo-teste-deploy
VAULT_DEPLOY_KEY_FILE=/caminho/para/a/chave
# Intervalo entre rodadas do curador, em segundos.
VAULT_INTERVALO=900

# --- Origens (DV-290) -----------------------------------------------------
# Pasta no host com as chaves de deploy SÓ LEITURA das origens, uma por
# sistema, com o nome da tag (ex.: <pasta>/sistema-a). Quem fornece: o dev,
# ao cadastrar o sistema (ver README). Pasta 700, chaves 600. Montada só no
# vault-init, que copia as chaves para o curador.
# Homologação (10.2.2.31): /home/tiago.santo/.config/petro-vault/origens
VAULT_ORIGENS_CHAVES_DIR=/caminho/para/a/pasta
# GitHub App petro-vault (DV-573): origens https://github.com/<dono>/<repo>, lidas
# sem chave de deploy. App ID na página do App; a chave privada (.pem, 600) fica
# fora do repositório e é montada só no vault-init, que a copia para o curador.
# Homologação (10.2.2.31): /home/tiago.santo/.config/petro-vault/github-app.pem
VAULT_GITHUB_APP_ID=5392441
VAULT_GITHUB_APP_CHAVE_FILE=/caminho/para/github-app.pem
# Arquivo da origem acima deste tamanho (bytes) fica fora da fila.
VAULT_LIMITE_BYTES=262144

# --- Curadoria com LLM (DV-291) -------------------------------------------
# Token próprio do curador do petro-vault (não o do observer), para acompanhar
# o consumo separado. Quem fornece: o dev, com `claude setup-token`. Vazio: o
# curador não chama o modelo, os itens ficam na fila e o log avisa.
VAULT_CLAUDE_CODE_OAUTH_TOKEN=
# Itens por lote (uma chamada do curador) e lotes por tag em cada rodada.
VAULT_LOTE=5
VAULT_LOTES_MAX=10
# Curador em paralelo (DV-606): quantos vaults são curados ao mesmo tempo (cada
# um chama o modelo; mais trabalhadores = mais gasto simultâneo) e quantos lotes
# um vault faz antes de ceder a vez (o resto da fila volta logo depois).
VAULT_TRABALHADORES=3
VAULT_LOTES_POR_VEZ=3
# Perfil código (DV-292): um lote é uma pasta da origem, até este número de arquivos.
VAULT_LOTE_CODIGO=12
# Falha de lote (DV-584): o item volta para o fim da fila, em lote menor. Com
# este número de tentativas fica parado (pedir de novo pela tela, em Fontes).
VAULT_TENTATIVAS_MAX=5
# Teto de gasto: lotes com falha por tag em cada rodada; depois, a tag espera a próxima.
VAULT_FALHAS_MAX=2

# --- Imagem do Hermes (curador) -------------------------------------------
# Fixada; atualizar só depois de testar o curador com a versão nova.
HERMES_IMAGE=nousresearch/hermes-agent:v2026.9.11
